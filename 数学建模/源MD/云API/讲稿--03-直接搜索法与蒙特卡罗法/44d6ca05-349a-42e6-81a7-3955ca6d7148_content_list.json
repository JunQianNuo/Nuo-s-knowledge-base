            616,
            125
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "1.1. 教学设计",
        "text_level": 2,
        "bbox": [
            28,
            151,
            291,
            212
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "最优化方法：",
        "bbox": [
            28,
            234,
            192,
            282
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "1.直接搜索法",
        "bbox": [
            77,
            286,
            255,
            331
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "2.蒙特卡罗法",
        "bbox": [
            77,
            334,
            255,
            382
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "教学要求：",
        "bbox": [
            28,
            385,
            163,
            430
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "了解两种方法的优缺点",
        "bbox": [
            81,
            434,
            375,
            485
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "知识点：",
        "text_level": 2,
        "bbox": [
            28,
            536,
            134,
            585
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "算法描述方法：流程图，伪代码…Matlab 伪代码",
        "bbox": [
            77,
            585,
            518,
            688
        ],
        "page_idx": 2
    },
    {
        "type": "footer",
        "text": "数学建模与实验",
        "bbox": [
            16,
            951,
            173,
            987
        ],
        "page_idx": 2
    },
    {
        "type": "page_number",
