    {
        "type": "equation",
        "text": "$$\n\\begin{array}{l} \\min f (x _ {1}, x _ {2}) \\\\ \\text { s.t. } \\left\\{ \\begin{array}{l} g (x _ {1}, x _ {2}) \\leq 0 \\\\ l _ {i} \\leq x _ {i} \\leq u _ {i} (i = 1, 2) \\end{array} \\right. \\end{array}\n$$",
        "text_format": "latex",
        "bbox": [
