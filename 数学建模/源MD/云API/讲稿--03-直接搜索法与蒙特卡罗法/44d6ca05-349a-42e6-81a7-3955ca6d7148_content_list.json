        "page_idx": 10
    },
    {
        "type": "equation",
        "text": "$$\nl _ {1}, l _ {2}, u _ {1}, u _ {2}\n$$",
        "text_format": "latex",
        "bbox": [
            31,
            440,
            149,
            485
        ],
        "page_idx": 10
    },
    {
        "type": "text",
        "text": "N 网格个数",
        "bbox": [
            33,
            514,
            197,
            556
        ],
        "page_idx": 10
    },
    {
        "type": "text",
        "text": "目标函数 $f ( x _ { 1 } , x _ { 2 } )$",
        "bbox": [
            28,
            588,
