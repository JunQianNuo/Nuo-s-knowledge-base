flowchart LR
  P["Problem statement and attachments"] --> T["Terms, objects, scales, ambiguities"]

  subgraph E0["E0: domain understanding"]
    B["Background"]
    M["Mechanisms"]
    R["Current rules and standards"]
    V["Variable definitions and measurement"]
  end

  T --> B & M & R & V
  B --> DC["DomainContext"]
  V --> VS["VariableSpec dictionary"]
  M --> MS["MechanismSpec candidates"]
  R --> BS["BusinessRuleSpec table"]

  DC & VS & MS & BS --> C{"Critical conflict or ambiguity?"}
  C -->|"yes"| Q["Verify authority or request user decision"]
  Q --> C
  C -->|"no"| PS["Freeze ProblemSpec and evaluation protocol"]

  subgraph E1["E1: methods and validation"]
    SM["Similar problems and mathematical models"]
    PA["Parameter basis and applicability"]
    VM["Validation methods, benchmarks, failure conditions"]
  end

  PS --> SM & PA & VM
  SM & PA & VM --> ER["EvidenceRecord + claim-level status"]
  ER --> MC["Generate ModelCandidates"]
  PS --> MC
  MC --> G["Seven model adequacy gates"]
  G -->|"FAIL or UNKNOWN"| X["Reject with reasons"]
  G -->|"all PASS"| S["Minimum-sufficient main model"]
  S --> A["Algorithm registry and P1"]
  A --> VAL["Full solve and validation"]
  VAL --> MAN["Artifacts, evidence snapshot, manifest"]

  ER -. "paper count never overrides gates" .-> G
