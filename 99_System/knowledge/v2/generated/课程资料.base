filters:
  or:
  - and:
    - file.inFolder("03_Sources/Courses")
    - '!/(^|\/)(assets|raw|resources|原始录制|原始转写|转换资料|附件|\.[^\/]+)(\/|$)/i.matches(file.path)'
  - and:
    - and:
      - file.inFolder("03_Sources")
      - '!/(^|\/)(assets|pdf课件|ppt课件|raw|resources|原始录制|原始转写|课件|转换资料|附件|\.[^\/]+)(\/|$)/i.matches(file.path)'
      - file.ext == "md"
      - or:
        - type == "idea"
        - and:
          - schema_version == 2
          - or:
            - type == "lecture"
            - type == "review"
            - type == "homework"
            - type == "book"
            - type == "paper"
            - type == "web"
    - subject != null
views:
- type: table
  name: 全部课程资料
  order:
  - file.name
  - file.ext
  - type
  - subject
  - status
  - polish_status
- type: table
  name: 专业写作基础
  filters:
    or:
    - file.inFolder("03_Sources/Courses/专业写作基础")
    - subject.contains("专业写作基础")
  order:
  - file.name
  - file.ext
  - type
  - status
  - polish_status
  - subject
- type: table
