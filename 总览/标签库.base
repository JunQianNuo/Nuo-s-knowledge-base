filters:
  and:
    - file.ext == "md"
    - file.inFolder("总览/标签库/条目")
    - type == "标签条目"
formulas:
  search_query: '"tag:" + canonical_tag'
properties:
  file.name:
    displayName: 标签记录
  note.canonical_tag:
    displayName: 标准标签
  note.tag_aliases:
    displayName: 同义名称
  note.source_kind:
    displayName: 登记依据
  note.promote:
    displayName: 参与补标
  note.status:
    displayName: 核对状态
  formula.search_query:
    displayName: 内置搜索检索式
  note.source:
    displayName: 来源示例
views:
  - type: table
    name: 全部标签
    order:
      - canonical_tag
      - tag_aliases
      - formula.search_query
      - source_kind
      - promote
      - status
      - file.name
  - type: table
    name: 概念检索词
    filters:
      and:
        - promote == true
    order:
      - canonical_tag
      - tag_aliases
      - formula.search_query
      - source_kind
      - file.name
  - type: table
    name: 历史标签待核对
    filters:
      and:
        - status == "待处理"
    order:
      - canonical_tag
      - tag_aliases
      - source_kind
      - source
      - file.name
