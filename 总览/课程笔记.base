filters:
  and:
    - file.ext == "md"
    - file.inFolder("课程")
properties:
  subject:
    displayName: 课程
  type:
    displayName: 类型
  status:
    displayName: 状态
  topics:
    displayName: 主题
  review_date:
    displayName: 下次复习
  file.mtime:
    displayName: 最近修改
views:
  - type: table
    name: 全部课程笔记
    order:
      - file.name
      - subject
      - type
      - status
      - topics
      - review_date
      - file.mtime
  - type: table
    name: 待处理课程资料
    filters:
      or:
        - status == "待处理"
        - status == "学习中"
    order:
      - file.name
      - subject
      - type
      - status
      - file.mtime
