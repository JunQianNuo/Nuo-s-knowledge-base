filters: file.ext == "md"
formulas:
  review_in_days: if(review_date, (date(review_date) - today()).days, "")
properties:
  subject:
    displayName: 课程或领域
  type:
    displayName: 类型
  status:
    displayName: 状态
  review_date:
    displayName: 下次复习
  due_date:
    displayName: 截止日期
  file.mtime:
    displayName: 最近修改
  formula.review_in_days:
    displayName: 距复习天数
views:
  - type: table
    name: 待处理
    filters: status == "待处理"
    order:
      - file.name
      - subject
      - type
      - status
      - file.mtime
  - type: table
    name: 待复习
    filters: status == "待复习"
    order:
      - file.name
      - subject
      - type
      - review_date
      - formula.review_in_days
  - type: table
    name: 学习中
    filters: status == "学习中"
    order:
      - file.name
      - subject
      - type
      - review_date
      - file.mtime
